{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "novarc-harness-doctor/record.schema.json",
  "title": "novarc-harness-doctor review record (v1)",
  "description": "What one review left for one harness: what was found, decided and changed, what each change was expected to save, and the measurements of that moment. Written by `run.mjs close` and `run.mjs history --write` under history/<harnessKey>/, read by the next run on the same harness. It holds display paths and masked text only. See references/follow-up.md.",
  "type": "object",
  "required": ["schema", "skillVersion", "harnessKey", "runId", "kind", "provider", "name", "path", "startedAt", "reviewedAt", "changesAppliedAt", "followUpAfter", "scores", "measure", "elements", "items"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "skillVersion": { "type": "string" },
    "harnessKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "The folder this record lives in: the slug of the harness name, a dash, and 8 hex characters of a SHA-256 over its kind, provider and real absolute path." },
    "runId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,40}$" },
    "kind": { "enum": ["user", "project"] },
    "provider": { "type": ["string", "null"] },
    "name": { "type": "string" },
    "path": { "type": "string", "description": "Display path: `~` for home. The absolute path is in history/index.json alone." },
    "startedAt": { "type": "string", "format": "date-time", "description": "When the run started." },
    "reviewedAt": { "type": "string", "format": "date-time", "description": "When the review ended: the moment the run was closed, or the record was written for a run that is still open. Writing the record of a closed run again keeps it." },
    "changesAppliedAt": { "type": ["string", "null"], "format": "date-time", "description": "When the last change of this harness was applied; null when nothing was." },
    "followUpAfter": { "type": "string", "format": "date-time", "description": "reviewedAt plus followUpAfterDays (references/catalog/follow-up.json)." },
    "followUpOf": {
      "type": "object",
      "description": "The record this review was compared with, when the harness had one.",
      "required": ["runId", "reviewedAt"],
      "additionalProperties": false,
      "properties": {
        "runId": { "type": "string" },
        "reviewedAt": { "type": "string", "format": "date-time" }
      }
    },
    "scores": {
      "type": "object",
      "required": ["baseline", "current", "projected", "grade", "rounds"],
      "additionalProperties": false,
      "properties": {
        "baseline": { "type": ["number", "null"], "description": "The harness as it was found." },
        "current": { "type": ["number", "null"], "description": "The harness as this review left it." },
        "projected": { "type": ["number", "null"], "description": "Where it lands once what was approved is applied." },
        "grade": { "type": ["string", "null"] },
        "rounds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["round", "status", "score"],
            "additionalProperties": false,
            "properties": {
              "round": { "$ref": "#/$defs/round" },
              "status": { "enum": ["pending", "done", "skipped", "not-applicable"] },
              "score": { "type": ["number", "null"], "description": "null for a round that is not done." }
            }
          }
        }
      }
    },
    "measure": {
      "type": ["object", "null"],
      "description": "The measurement of this review's window; null when the harness was not measured (see measureSkipped).",
      "required": ["window", "sessions", "metrics"],
      "additionalProperties": false,
      "properties": {
        "window": {
          "type": "object",
          "required": ["days"],
          "additionalProperties": false,
          "properties": {
            "from": { "type": "string", "format": "date-time" },
            "to": { "type": "string", "format": "date-time" },
            "days": { "type": "integer", "minimum": 1 }
          }
        },
        "sessions": { "type": "integer", "minimum": 0 },
        "activeDays": { "type": "integer", "minimum": 0 },
        "metrics": {
          "type": "object",
          "description": "The comparable numbers, per session (references/follow-up.md, \"Comparable metrics\"). A metric that was not measured is absent, never 0.",
          "additionalProperties": false,
          "properties": {
            "tokens-per-session": { "type": "number", "minimum": 0 },
            "weighted-per-session": { "type": "number", "minimum": 0 },
            "context-at-start": { "type": "number", "minimum": 0 },
            "context-peak": { "type": "number", "minimum": 0 },
            "waste-share": { "type": "number", "minimum": 0 },
            "waste:retry": { "type": "number", "minimum": 0 },
            "waste:loop": { "type": "number", "minimum": 0 },
            "waste:notfound": { "type": "number", "minimum": 0 },
            "waste:correction": { "type": "number", "minimum": 0 },
            "waste:hook-block": { "type": "number", "minimum": 0 },
            "waste:error-end": { "type": "number", "minimum": 0 },
            "waste:exploration": { "type": "number", "minimum": 0 },
            "tool-output": { "type": "number", "minimum": 0 }
          }
        },
        "unused": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "skills": { "type": "array", "items": { "type": "string" } },
            "mcpServers": { "type": "array", "items": { "type": "string" } }
          }
        },
        "coverage": {
          "type": "object",
          "description": "How well the tool calls of each source could be read in that window.",
          "additionalProperties": false,
          "properties": {
            "claude": { "enum": ["not-read", "complete", "partial", "unknown"] },
            "codex": { "enum": ["not-read", "complete", "partial", "unknown"] }
          }
        }
      }
    },
    "measureSkipped": { "enum": ["shared-sessions", "no-transcript-reader", "not-measured"], "description": "Why `measure` is null. not-measured: the impact probe did not run or failed." },
    "elements": {
      "type": "object",
      "description": "How many elements of each kind the harness had.",
      "additionalProperties": false,
      "properties": {
        "permissions": { "type": "integer", "minimum": 0 },
        "hooks": { "type": "integer", "minimum": 0 },
        "skills": { "type": "integer", "minimum": 0 },
        "agents": { "type": "integer", "minimum": 0 },
        "plugins": { "type": "integer", "minimum": 0 },
        "mcp": { "type": "integer", "minimum": 0 },
        "clis": { "type": "integer", "minimum": 0 },
        "docs": { "type": "integer", "minimum": 0 }
      }
    },
    "items": {
      "type": "array",
      "description": "Every item of the harness, whatever its status.",
      "items": {
        "type": "object",
        "required": ["id", "rev", "round", "severity", "class", "title", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{0,5}-[0-9]{1,3}$" },
          "rev": { "type": "string", "pattern": "^[0-9a-f]{12}$" },
          "round": { "$ref": "#/$defs/round" },
          "severity": { "enum": ["critical", "high", "medium", "low"] },
          "class": { "type": "string" },
          "title": { "type": "string" },
          "status": { "enum": ["open", "approved", "in-progress", "fixed", "failed", "declined", "deferred", "ok", "not-applicable"] },
          "decision": {
            "type": "object",
            "description": "The user's last decision on this item, when it has one.",
            "required": ["action", "at"],
            "additionalProperties": false,
            "properties": {
              "action": { "enum": ["approve", "decline", "defer"] },
              "at": { "type": "string", "format": "date-time" },
              "note": { "type": "string" }
            }
          },
          "fixedAt": { "type": "string", "format": "date-time" },
          "verified": { "type": "string" },
          "notVerified": { "type": "string" },
          "principle": { "type": "string", "description": "The rule to keep, from the item's lesson." },
          "saves": {
            "type": "object",
            "required": ["tokens", "basis"],
            "additionalProperties": false,
            "properties": {
              "tokens": { "type": "integer", "minimum": 0 },
              "basis": { "enum": ["measured", "estimated"] },
              "metric": { "type": "string" },
              "how": { "type": "string" }
            }
          },
          "previous": {
            "type": "object",
            "description": "The same finding in an earlier review of this harness.",
            "required": ["run", "item"],
            "additionalProperties": false,
            "properties": {
              "run": { "type": "string" },
              "item": { "type": "string" }
            }
          },
          "changes": {
            "type": "array",
            "description": "Kept for fixed items only: what the on-disk check of the next review needs.",
            "items": {
              "type": "object",
              "required": ["path", "before", "after"],
              "additionalProperties": false,
              "properties": {
                "path": { "type": "string", "description": "Display path." },
                "before": { "type": "string" },
                "after": { "type": "string" },
                "insertAfter": { "type": "string" },
                "hashAfter": { "type": ["string", "null"], "description": "SHA-256 of the file after the change, from the ledger; null when the change removed the file; absent when the change was not recorded in the ledger." },
                "deleted": { "type": "boolean", "description": "true when the change removed the file." }
              }
            }
          }
        }
      }
    },
    "outcome": {
      "type": "object",
      "description": "The comparison this review made with the record before it: the `followUp` object of state.schema.json (`$defs.followUp`), validated against that definition."
    }
  },
  "$defs": {
    "round": { "type": "integer", "minimum": 1, "maximum": 8 }
  }
}
